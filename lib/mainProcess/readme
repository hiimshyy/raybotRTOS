// Robot info
int Motor1_mode = 0; // 0 - stop, 1 - forward, 2 - backward
int Motor2_mode = 0; // 0 - stop, 1 - up, 2 - down
int PWM_MT_1 = 0; // motor 1 PWM
int PWM_MT_2 = 0; // motor 2 PWM
int maxSpeedMovement = 150; // max speed of motor 1
int maxSpeedLift = 150; // max speed of motor 2
int motorParam = 5; // motor param
int maxDistanceMove = 20; // max distance of motor 1
int minDistanceMove = 10; // min distance of motor 1
int minDistanceLift = 20; // min distance of motor 2
int maxDistanceLift = 40; // max distance of motor 2
float weight = 0; // weight of robot
float battery = 0; // battery level of robot
float distanceFW = 0; // distance from forward sensor
float distanceBW = 0; // distance from backward sensor
float distanceUD = 0; // distance from up-down sensor
bool safety = false; // safety flag
bool door_state = false; // door state flag
bool taskActive = false; // task active flag
String command = ""; // command from user

